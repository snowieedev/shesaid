# ==============================================================================
# SheSaid — The Female Language Translator Environment Variables
# ==============================================================================

# APINext.bond or any OpenAI-compatible API Provider Base URL
# Examples:
# - APINext.bond: https://api.apinext.bond/v1
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Groq: https://api.groq.com/openai/v1
API_BASE_URL=https://api.apinext.bond/v1

# Your API Key for APINext.bond or OpenAI-compatible provider
# Note: If left blank or unset in local development, SheSaid automatically
# runs in Smart Heuristic Demo Mode with realistic, witty AI-style decodes!
API_KEY=your_api_key_here

# AI Model Identifier
# Select the cheapest capable text-generation model available on your provider
# Examples for APINext.bond / OpenAI-compatible:
# - gpt-4o-mini (recommended budget choice)
# - gpt-3.5-turbo
# - claude-3-haiku-20240307
# - deepseek-chat
AI_MODEL=gpt-4o-mini
